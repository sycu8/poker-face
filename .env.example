# Copy to .dev.vars for local Wrangler / Vite Worker secrets.
# Never commit real secrets.

ENVIRONMENT=local
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-long-random-string

# Cloudflare Turnstile (public site key is also set in wrangler.jsonc vars).
# Secret is required for staging/production; local fails open if unset.
TURNSTILE_SECRET=
# Optional override; defaults to APP_ORIGIN hostname when empty:
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional OAuth (GitHub + Google). Both client id and secret required per provider.
# Callback URLs (register each in the provider console):
#   {APP_ORIGIN}/api/auth/oauth/github/callback
#   {APP_ORIGIN}/api/auth/oauth/google/callback
# Local .dev.vars / Worker secret names:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub Actions secret names for the GitHub provider must be OAUTH_GITHUB_CLIENT_ID /
# OAUTH_GITHUB_CLIENT_SECRET (Actions reserves the GITHUB_ prefix).

# RealtimeKit voice (required for /api/rooms/:id/voice-token)
CLOUDFLARE_ACCOUNT_ID=
REALTIMEKIT_APP_ID=6867ec48-6a1e-43b9-b940-a542afad90d3
# Cloudflare API token with Realtime Admin — NOT the Calls TURN key API token
REALTIMEKIT_API_TOKEN=
# Must match a preset on the RealtimeKit app (dashboard). Default used if unset:
REALTIMEKIT_PRESET_NAME=group_call_participant

# Optional: Cloudflare Calls TURN key (dashboard name may be e.g. poker-call).
# RealtimeKit voice does not need these; store for ops / custom WebRTC only.
TURN_KEY_ID=c07d4ea34ad3c340d3c96ab9781dd477
TURN_KEY_API_TOKEN=
TURN_KEY_NAME=poker-call
